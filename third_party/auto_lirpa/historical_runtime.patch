+class BoundStep(BoundActivation):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.split_status = None
+
+    def forward(self, x):
+        self.input_shape = x.shape
+        return (x > 0).float()
+
+    def interval_propagate(self, *v):
+        x_L, x_U = v[0]
+        if hasattr(self, 'split_status') and self.split_status is not None:
+            x_U = torch.where(self.split_status == -1, torch.minimum(x_U, torch.zeros_like(x_U)), x_U)
+            x_L = torch.where(self.split_status == 1, torch.maximum(x_L, torch.ones_like(x_L) * 1e-8), x_L)
+        lower = torch.where(x_L > 0, torch.ones_like(x_L), torch.zeros_like(x_L))
+        upper = torch.where(x_U <= 0, torch.zeros_like(x_U), torch.ones_like(x_U))
+        return lower, upper
+
+    def bound_relax(self, x, init=False, **kwargs):
+        x_L, x_U = x.lower, x.upper
+        d_u = torch.zeros_like(x_L)
+        b_u = torch.where(x_U <= 0, torch.zeros_like(x_L), torch.ones_like(x_L))
+        d_l = torch.zeros_like(x_L)
+        b_l = torch.where(x_L > 0, torch.ones_like(x_L), torch.zeros_like(x_L))
+
+        cross_zero = (x_L < 0) & (x_U > 0)
+        d_u = torch.where(cross_zero, 1.0 / (-x_L + 1e-8), d_u)
+        b_u = torch.where(cross_zero, torch.ones_like(x_L), b_u)
+        d_l = torch.where(cross_zero, 1.0 / (x_U + 1e-8), d_l)
+        b_l = torch.where(cross_zero, torch.zeros_like(x_L), b_l)
+
+        if hasattr(self, 'split_status') and self.split_status is not None:
+            d_u = torch.where(self.split_status == -1, torch.zeros_like(d_u), d_u)
+            b_u = torch.where(self.split_status == -1, torch.zeros_like(b_u), b_u)
+            d_l = torch.where(self.split_status == -1, torch.zeros_like(d_l), d_l)
+            b_l = torch.where(self.split_status == -1, torch.zeros_like(b_l), b_l)
+
+            d_u = torch.where(self.split_status == 1, torch.zeros_like(d_u), d_u)
+            b_u = torch.where(self.split_status == 1, torch.ones_like(b_u), b_u)
+            d_l = torch.where(self.split_status == 1, torch.zeros_like(d_l), d_l)
+            b_l = torch.where(self.split_status == 1, torch.ones_like(b_l), b_l)
+
+        self.lw, self.uw = d_l, d_u
+        self.lb, self.ub = b_l, b_u
+        return d_u, b_u, d_l, b_l
+
+
